---
import Base from '../layouts/Base.astro';import FilmProgramme from '../components/FilmProgramme.astro';import BandeAnnonce from '../components/BandeAnnonce.astro';import {projets} from '../data/projets.js';import {Image,getImage} from 'astro:assets';import affiche from '../assets/projets/vivez-affiche-1.png';import portrait from '../assets/accueil/portrait-halftone.png';
const fond=await getImage({src:affiche,width:1200,format:'webp',quality:80});
---
<Base titre="Direction artistique et création numérique" description="Noah Litzler, étudiant en BUT MMI à Montbéliard. Trois projets en illustration, identité et datavisualisation. En recherche de stage." suivant="affiche">
 <section class="opening ouverture-film" style={'--art:url('+fond.src+')'} aria-labelledby="nom-noah">
  <div class="opening-art" aria-hidden="true"></div><p class="opening-tag"><span></span>Une séance de création numérique</p>
  <div class="title-block"><p class="byline">Direction artistique &amp; design d’interfaces</p><h1 id="nom-noah">Noah<br/><span>Litzler</span></h1></div>
  <div class="opening-copy"><p>Des idées qui prennent forme.<br/>Des images qui restent.</p><span>Étudiant en BUT MMI.<br/>En recherche de stage.</span></div>
  <a class="entry-link" href="#programmation"><span class="entry-arrow" aria-hidden="true">↗</span><span>Découvrir les trois séances<small>Affiche · Identité · Datavisualisation</small></span></a>
  <button type="button" class="voir-annonce" data-annonce-open aria-haspopup="dialog">Voir la bande-annonce <span aria-hidden="true">▶</span></button>
  <span class="frame-corner" aria-hidden="true">NL / PREMIÈRE PROJECTION</span>
 </section>
 <BandeAnnonce />
 <section class="programmation" id="programmation" aria-labelledby="titre-programme"><header class="titre-programme"><p class="sur-titre">Trois projets. Trois façons de raconter.</p><h2 id="titre-programme">À l’affiche<span>03</span></h2></header>{projets.map(p=><FilmProgramme projet={p}/>)}</section>
 <section class="auteur-home" aria-labelledby="titre-auteur"><div class="auteur-portrait"><Image src={portrait} alt="Portrait de Noah Litzler en demi-teinte" widths={[400,600,800]} sizes="(max-width:48rem) 90vw,40vw" format="webp" /></div><div><p class="sur-titre">Derrière les images</p><h2 id="titre-auteur">Moi, c’est<br/>Noah.</h2><p>Je conçois des identités visuelles et des interfaces, de l’idée jusqu’à l’écran. Étudiant en BUT MMI à Montbéliard, parcours création numérique, je cherche un stage en agence créative ou en studio de design.</p><a class="lien-editorial" href="/a-propos">Découvrir le hors-champ ↗</a></div></section>
</Base>