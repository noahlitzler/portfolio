---
import AutresSeances from "../components/AutresSeances.astro";
import Base from "../layouts/Base.astro";
import Affiche from "../components/Affiche.astro";
import { projets } from "../data/projets.js";
---
<Base titre="Projets" description="Trois études de cas en illustration, branding et datavisualisation, ainsi que SULL, plateforme de découverte cinématographique." timecode="00:03:12:08" progression={32} precedent="accueil" suivant="apropos">
  <section class="projets">
    <p class="etiquette">Programmation 2025 - 2026</p>
    <h1>À l’affiche</h1>
    <p class="intro">Trois salles, trois genres : l’image, l’écran et la marque. Choisis ta séance pour découvrir les making-of.</p>

    <ul class="salles">
      {projets.map((p) => (
        <li>
          <article class="salle" style={"--accent: " + p.accent}>
            <a class="affiche" href={'/projets/'+p.slug} aria-label={'Découvrir '+p.titre}><Affiche projet={p} /></a>
            <div class="pied-carte">
              <p class="num">{p.numero} / 03</p>
              <h2>{p.categorie}</h2>
              <p class="mots">{p.mots}</p>
              <a class="voir" href={"/projets/" + p.slug} aria-label={"Voir la séance " + p.titre}>Voir la séance</a>
            </div>
          </article>
        </li>
      ))}
    </ul>

    <p class="astuce">Survole une salle pour l’ouvrir.</p>
  </section>
  <AutresSeances />
</Base>

<style>
  .projets { padding: clamp(3rem, 8.1vw, 8.75rem) var(--gouttiere) 3rem; }
  .etiquette {
    display: inline-block;
    margin: 0;
    padding: 0.3rem 0.75rem;
    background: var(--creme);
    color: var(--ebene);
    border-left: 4px solid var(--rose);
    font-family: var(--font-label);
    font-weight: 700;
    font-size: var(--taille-label);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transform: rotate(-1.5deg);
  }
  h1 {
    margin: 1.5rem 0;
    font-family: var(--font-titre);
    font-weight: 700;
    font-size: clamp(3.5rem, 11vw, 10rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .intro {
    max-width: 42rem;
    margin: 0;
    font-size: 1.125rem;
    color: color-mix(in srgb, var(--creme) 80%, transparent);
  }
  .salles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .salle { position: relative; }
  .affiche {
    display: block;
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: color-mix(in srgb, var(--accent) 25%, var(--ebene));
    transition: transform 0.3s ease;
  }
  .salle:hover .affiche, .salle:focus-within .affiche { transform: translateY(-0.5rem) rotate(-1deg); box-shadow: -6px -6px var(--bleu), 6px 6px var(--rose); }
  .art { position: absolute; inset: 0; }
  .art :global(img), .art :global(.vide) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    object-fit: cover;
  }
  .haut {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 1rem 1.5rem 2rem;
    background: linear-gradient(var(--ebene) 45%, transparent);
    font-family: var(--font-label);
    font-size: var(--taille-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .bas {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    padding: 3.5rem 1.5rem 1.25rem;
    background: linear-gradient(transparent, color-mix(in srgb, var(--ebene) 92%, transparent) 55%);
  }
  .a-l-affiche {
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--creme);
    font-family: var(--font-label);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .legende {
    margin: 0.75rem 0;
    font-family: var(--font-label);
    font-size: var(--taille-label);
    letter-spacing: 0.05em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .seance-nom {
    margin: 0;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: var(--taille-label);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .pied-carte {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 0.4rem 1rem;
    padding-top: 1.25rem;
  }
  .pied-carte > * { grid-column: 1; }
  .num {
    justify-self: start;
    margin: 0;
    padding: 0.2rem 0.6rem;
    background: var(--creme);
    color: var(--ebene);
    border-left: 4px solid var(--rose);
    font-family: var(--font-label);
    font-weight: 700;
    font-size: var(--taille-label);
    letter-spacing: 0.12em;
  }
  .pied-carte h2 {
    margin: 0;
    font-family: var(--font-titre);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  .mots {
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--taille-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--creme) 70%, transparent);
  }
  .voir {
    grid-column: 2;
    grid-row: 2 / 4;
    padding-bottom: 0.25rem;
    border-bottom: 2px solid var(--creme);
    font-family: var(--font-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  .voir::before { content: "▶" / ""; margin-right: 0.5rem; font-size: 0.75em; }
  .voir::after { content: ""; position: absolute; inset: 0; }
  .salle:has(.voir:focus-visible) { outline: 3px solid var(--rose); outline-offset: 6px; }
  .astuce {
    margin: 3rem 0 0;
    text-align: center;
    color: color-mix(in srgb, var(--creme) 70%, transparent);
  }
  @media (hover: none) { .astuce { display: none; } }
  @media (max-width: 62rem) {
    .salles { grid-template-columns: 1fr; max-width: 32rem; }
  }
</style>