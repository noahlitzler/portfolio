---
import Base from '../layouts/Base.astro';
import {Image} from 'astro:assets';
import portrait from '../assets/accueil/portrait-halftone.png';
const horsChamp=[['Dans le casque','Les albums de Michael Jackson'],['Sur la table de chevet','Absolute Batman'],['À l’écran','Scarface, Le Parrain'],['En tournage','Ce portfolio']];
---
<Base timecode="00:07:40:16" progression={68} precedent="affiche" suivant="contact" titre="À propos" description="Je suis Noah Litzler, étudiant en BUT MMI à Montbéliard. Mon histoire, mes références et ma direction artistique, plan par plan.">
<section class="storyboard">
  <header class="intro"><p class="tag">Storyboard</p><h1>À propos</h1><p>Mon histoire, plan par plan.</p></header>
  <div class="planche">
    <div class="bande premiere">
      <section class="plan portrait" aria-labelledby="plan1"><h2 id="plan1">Plan 1 - Plan large</h2><Image src={portrait} alt="Portrait de Noah Litzler en demi-teinte, contours bleus et roses" widths={[480,900,1200]} sizes="(max-width: 60rem) 90vw, 52vw" format="webp" /><p class="recit">Montbéliard, 2026. Je suis étudiant en BUT MMI, parcours création numérique.</p><p class="bulle">Moi, c’est Noah.</p></section>
      <section class="plan references" aria-labelledby="plan2"><h2 id="plan2">Plan 2 - Gros plan</h2><div class="posters"><img src="/figma/7bf36.png" alt="Affiche du film Miami Vice" loading="lazy" width="210" height="313" /><img src="/figma/62d01.png" alt="Affiche de Spider-Man : Across the Spider-Verse" loading="lazy" width="210" height="313" /></div><p class="recit">Ce qui m’a donné envie : les affiches de Miami Vice et Spider-Man : Across the Spider-Verse.</p></section>
    </div>
    <div class="bande seconde">
      <section class="plan insert" aria-labelledby="plan3"><h2 id="plan3">Plan 3 - Insert</h2><p>Des images qu’on reconnaît en une seconde.</p></section>
      <section class="plan loisirs" aria-labelledby="plan4"><h2 id="plan4">Plan 4 - Plan moyen</h2><p class="recit">En dehors du design :</p><p class="passions">Comics.<br/>Films.<br/>Street workout.</p><img class="trame" src="/figma/9a389.png" alt="" loading="lazy" /></section>
      <section class="plan contrechamp" aria-labelledby="plan5"><h2 id="plan5">Plan 5 - Contrechamp</h2><p class="bulle">Ce qui m’agace ? Les portfolios remplis de projets sans lien avec la spécialité de leur auteur.</p><p class="recit">Ici, chaque projet va dans le sens de la direction artistique.</p></section>
    </div>
    <div class="bande derniere">
      <section class="plan travelling" aria-labelledby="plan6"><h2 id="plan6">Plan 6 - Travelling avant</h2><p>Je transforme une idée en <span>univers visuel</span> et en expérience numérique cohérente.</p><img class="trame" src="/figma/9a389.png" alt="" loading="lazy" /><span class="mouvement" aria-hidden="true">Travelling avant <img src="/figma/950bf.svg" alt="" /></span></section>
      <section class="plan hors-champ" aria-labelledby="plan7"><h2 id="plan7">Plan 7 - Hors-champ</h2><dl>{horsChamp.map(([titre,texte])=><div><dt>{titre}</dt><dd>{texte}</dd></div>)}</dl></section>
    </div>
    <p class="a-suivre">À suivre au guichet…</p>
  </div>
  <a class="guichet" href="/contact">◀◀ Passer au guichet</a>
</section>
</Base>
<style>
.storyboard{padding:clamp(3rem,8.1vw,8.75rem) var(--gouttiere) clamp(4rem,8vw,8rem)}.intro{margin-bottom:4rem}.intro>p:last-child{font-size:1.375rem;color:#f2eee5cc}.tag{display:inline-block;margin:0;padding:.4rem .9rem;border-left:5px solid var(--rose);background:var(--creme);color:var(--ebene);font:700 .875rem var(--font-label);letter-spacing:.12em;text-transform:uppercase;transform:rotate(1.5deg)}h1{font:700 clamp(4rem,9.26vw,10rem)/1 var(--font-titre);letter-spacing:-.05em;margin:2rem 0}.planche{background:var(--creme);color:var(--ebene);padding:clamp(.65rem,2.3vw,2.5rem)}.bande{display:grid;gap:clamp(.65rem,1.15vw,1.25rem);margin-bottom:1.25rem}.premiere{grid-template-columns:1.76fr 1fr}.seconde{grid-template-columns:repeat(3,minmax(0,1fr))}.derniere{grid-template-columns:2.04fr 1fr}.plan{position:relative;border:5px solid var(--ebene);overflow:hidden;isolation:isolate;background:var(--brun-salle);color:var(--creme);min-width:0}.premiere .plan{min-height:clamp(22rem,30.1vw,32.5rem)}.seconde .plan{min-height:clamp(18rem,24.3vw,26.25rem)}.derniere .plan{min-height:clamp(19rem,22vw,24rem)}h2{position:absolute;inset:0 auto auto 0;z-index:4;background:var(--ebene);color:var(--creme);margin:0;padding:.4rem .65rem;font:700 .75rem var(--font-label);letter-spacing:.12em;text-transform:uppercase}.portrait>img{position:absolute;top:-6%;width:100%;max-width:none;height:auto}.recit{position:relative;background:var(--jaune);border:3px solid var(--ebene);color:var(--ebene);padding:.85rem 1rem;font:700 clamp(.875rem,1vw,1.0625rem)/1.25 var(--font-label);text-transform:uppercase;letter-spacing:.03em;z-index:2}.portrait .recit{width:38%;margin:1.5rem 1rem 0 auto}.bulle{position:relative;margin:0;padding:1.2rem 1.6rem;background:white;color:var(--ebene);border:3px solid var(--ebene);border-radius:2rem;text-align:center;font:700 clamp(1rem,1.15vw,1.25rem)/1.2 var(--font-label);text-transform:uppercase;z-index:2}.bulle::after{content:'';position:absolute;width:1rem;height:1rem;bottom:-.65rem;left:20%;background:white;border-right:3px solid var(--ebene);border-bottom:3px solid var(--ebene);transform:rotate(45deg)}.portrait .bulle{position:absolute;left:6%;bottom:20%;max-width:45%}.references{display:flex;flex-direction:column;justify-content:flex-end;padding:1rem}.posters{display:flex;justify-content:center;align-items:center;gap:0;padding:2.3rem 0 1rem;flex:1}.posters img{width:47%;height:auto;aspect-ratio:210/313;object-fit:cover;border:6px solid white;transform:rotate(-4deg);box-shadow:0 1rem 1.5rem #0008}.posters img+img{transform:rotate(5deg);margin-left:-.2rem}.references .recit{margin:1rem 0 0}.insert{display:flex;align-items:center;background:var(--ebene);padding:2rem 1.6rem}.insert>p{font:700 clamp(1.8rem,3vw,3.25rem)/.98 var(--font-titre);letter-spacing:-.04em;text-shadow:-4px -4px var(--bleu),4px 4px var(--rose)}.loisirs{background:var(--rose);padding:2.5rem 1.6rem 1rem;color:var(--ebene)}.loisirs .recit{display:inline-block;background:var(--creme)}.passions{position:relative;z-index:1;font:700 clamp(2rem,3.125vw,3.375rem)/1 var(--font-label);letter-spacing:.02em;text-transform:uppercase;margin:1rem 0}.trame{position:absolute;inset:auto 0 0;width:100%;height:60%;object-fit:cover;z-index:-1}.contrechamp{background:var(--bleu);padding:3.4rem 1.5rem 1rem;display:flex;flex-direction:column;justify-content:space-between;gap:2rem}.contrechamp .recit{background:var(--vert-acide);margin:0}.travelling{background:var(--creme);color:var(--ebene);padding:3rem 1.5rem}.travelling>p{font:700 clamp(1.8rem,2.7vw,3rem)/1.2 var(--font-titre);letter-spacing:-.04em;margin:1rem 0}.travelling>p span{color:var(--bleu)}.travelling .trame{height:55%;object-position:top}.mouvement{position:absolute;right:1rem;bottom:1rem;display:flex;align-items:center;gap:1rem;background:var(--ebene);color:var(--creme);padding:.75rem;font:700 .75rem var(--font-label);text-transform:uppercase}.mouvement img{max-width:none}.hors-champ{padding:3rem 1.5rem 1rem}.hors-champ dl{margin:0}.hors-champ dl>div{border-bottom:1px solid #f2eee526;padding:.6rem 0}dt{font:.75rem var(--font-label);text-transform:uppercase;letter-spacing:.12em;color:#f2eee5bb}dd{margin:.3rem 0 0;font-weight:700}.a-suivre{text-align:right;font:700 1rem var(--font-label);text-transform:uppercase;letter-spacing:.1em;margin:1.3rem 0 0}.guichet{display:block;width:fit-content;margin:4rem 0 0 auto;padding-bottom:.5rem;border-bottom:2px solid #f2eee580;font:700 1rem var(--font-label);text-transform:uppercase;letter-spacing:.12em;text-decoration:none}.guichet:hover{color:var(--jaune)}@media(max-width:60rem){.premiere,.derniere{grid-template-columns:1fr}.seconde{grid-template-columns:1fr 1fr}.contrechamp{grid-column:1/-1}.premiere .portrait{min-height:30rem}.references{min-height:32rem!important}.posters{max-width:32rem;margin:auto}.derniere .plan{min-height:22rem}.intro{margin-bottom:2rem}}@media(max-width:36rem){.seconde{grid-template-columns:1fr}.premiere .portrait{min-height:24rem}.portrait .recit{width:55%;font-size:.875rem}.portrait>img{width:120%;left:-10%}.insert{min-height:16rem}.contrechamp{min-height:24rem}.passions{font-size:3rem}.travelling>p{font-size:2rem}.plan{border-width:3px}.bulle{font-size:1rem}}
</style>