---
export const prerender=true;
import Base from '../layouts/Base.astro';
import Bandeau from '../components/Bandeau.astro';
import Visuel from '../components/Visuel.astro';


---
<Base titre="À propos" description="Je suis Noah Litzler, étudiant en création numérique. Mon univers, mes inspirations et ma recherche de stage en design graphique et direction artistique.">
  <article class="hors-champ">
    <header class="intro"><div><p class="tag">Hors-champ / Le storyboard</p><h1>Derrière<br/>les images<span>.</span></h1></div><p>Moi, c’est Noah. J’imagine des univers visuels, puis je cherche la forme qui leur donne du caractère.</p></header>
    <div class="storyboard">
      <section class="plan portrait"><p class="repere">01 / Plan large</p><img src="/portrait-noah.webp" alt="Portrait de Noah Litzler en demi-teinte bleue et rose" width="720" height="900" loading="eager" /><div class="cartouche"><h2>Noah Litzler</h2><p>BUT MMI · Création numérique<br/>Montbéliard, 2026</p></div></section>
      <section class="plan intention"><p class="repere">02 / Note d’intention</p><h2>Une imagination<br/>qui prend forme.</h2><p>Ce qui m’anime, c’est de partir d’une idée et de lui donner une identité. Je m’intéresse surtout au design graphique et à la direction artistique : les couleurs, les lettres, la composition et ce qu’une image raconte.</p><p>J’aime chercher une proposition personnelle et pousser un concept jusqu’à construire un univers cohérent.</p><div class="qualites"><span>Imagination</span><span>Créativité</span><span>Originalité</span></div></section>
      <section class="plan influences"><p class="repere">03 / Ce qui nourrit mon regard</p><h2>Le sens du cadre.<br/>Le goût du rythme.</h2><dl><div><dt>Cinéma</dt><dd>Le cadrage, la lumière et la force d’une image.</dd></div><div><dt>Michael Jackson</dt><dd>Un univers reconnaissable, de la musique à la mise en scène.</dd></div><div><dt>Comics</dt><dd>La composition des planches et le mouvement dans une image fixe.</dd></div></dl></section>
      <section class="plan creations"><p class="repere">04 / Du concept à l’affiche</p><a href="/projets/vivez-l-essentiel" aria-label="Découvrir mes affiches Vivez l’essentiel"><Visuel agrandissable={false} fichier="vivez-affiche-2.png" alt="Mon illustration de l’Hôtel Peugeot pour Vivez l’essentiel" widths={[360,600,960]} sizes="(max-width:48rem) 40vw, 20vw" /></a><div><h2>Mon terrain<br/>d’expression.</h2><p>Des affiches, des identités et des expériences numériques. Chaque projet me permet d’explorer une autre manière de raconter.</p><a class="lien" href="/projets">Voir mes cinq projets ↗</a></div></section>
      <section class="plan personnel"><p class="repere">05 / En dehors du cadre</p><h2>Films.<br/>Comics.<br/>Street workout.</h2><p>Des centres d’intérêt qui nourrissent ma curiosité, mon imaginaire et mon goût du mouvement.</p><span class="annotation">Toujours une idée en tête.</span></section>
      <section class="plan prochain"><p class="repere">06 / Le prochain chapitre</p><h2>Un stage pour<br/>aller plus loin.</h2><p>Je recherche un stage en <strong>design graphique et direction artistique</strong>, du <strong>29 mars au 4 juin 2027</strong>.</p><p>Haut-Rhin, Bâle, Porrentruy et alentours.</p><a class="billet" href="/contact">Écrivons la suite ↗</a></section>
    </div>
  </article>
  <Bandeau texte="Imagination - Créativité - Originalité - Noah Litzler" />
</Base>
<style>
.hors-champ{max-width:105rem;margin:auto;padding:clamp(2.5rem,6vw,6rem) var(--gouttiere) clamp(3rem,6vw,6rem)}.intro{display:grid;grid-template-columns:1.25fr 1fr;align-items:end;gap:3rem;margin-bottom:3rem}.tag{font:700 .75rem var(--font-label);color:var(--rose);letter-spacing:.13em;text-transform:uppercase;margin:0 0 1.5rem}h1{font:700 clamp(3.5rem,7vw,8rem)/.9 var(--font-titre);letter-spacing:-.05em;margin:0}h1>span{color:var(--rose)}.intro>p{font-size:clamp(1.1rem,1.6vw,1.5rem);max-width:30rem;line-height:1.6;margin:0;color:#f2eee5b3}.storyboard{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1.25rem}.plan{position:relative;min-width:0;padding:2rem;border:1px solid #f2eee533;background:var(--brun-salle);overflow:hidden}.repere{font:700 .7rem var(--font-label);letter-spacing:.12em;text-transform:uppercase;margin:0 0 2rem;color:#f2eee599}.plan h2{font:700 clamp(1.6rem,2.8vw,3rem)/1 var(--font-titre);letter-spacing:-.035em;margin:0 0 1.5rem}.plan p:not(.repere){line-height:1.7;font-size:1rem;color:#f2eee5c4;margin:1rem 0 0}.portrait{grid-column:span 4;padding:0;background:#12224a;min-height:27rem}.portrait .repere{position:absolute;left:1.5rem;top:1.25rem;z-index:2;color:var(--creme)}.portrait>img{width:100%;height:100%;object-fit:cover;object-position:center 15%;position:absolute;inset:0}.cartouche{position:absolute;inset:auto 0 0;padding:5rem 1.5rem 1.5rem;background:linear-gradient(transparent,#0e0b0af5 62%)}.cartouche h2{margin:0;font-size:2.5rem}.cartouche p{font:.8rem/1.6 var(--font-label)!important;letter-spacing:.04em}.intention{grid-column:span 8;padding:clamp(2rem,3.5vw,4rem)}.intention h2{font-size:clamp(2.5rem,4vw,4.5rem)}.intention>p:not(.repere){max-width:43rem}.qualites{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:2rem}.qualites span{font:500 .75rem var(--font-label);text-transform:uppercase;letter-spacing:.05em;border:1px solid #f2eee54d;padding:.5rem .7rem}.influences{grid-column:span 5;background:var(--creme);color:var(--ebene)}.influences .repere{color:#0e0b0a99}.influences dl{margin:0}.influences dl>div{padding:.8rem 0;border-bottom:1px solid #0e0b0a26}.influences dt{font:700 .8rem var(--font-label);letter-spacing:.1em;text-transform:uppercase}.influences dd{font-size:.95rem;line-height:1.5;margin:.4rem 0 0;color:#0e0b0ac9}.creations{grid-column:span 7;display:grid;grid-template-columns:.8fr 1fr;gap:2rem;align-items:center;background:radial-gradient(ellipse at 15% 70%,#3155ff25,transparent 80%),var(--brun-salle)}.creations .repere{grid-column:1/-1;margin-bottom:0}.creations>a{display:block;transform:rotate(-7deg);max-width:16rem;box-shadow:0 .75rem 1rem #0005}.creations>a :global(img){width:100%;height:auto}.lien{display:inline-block;font:700 .8rem var(--font-label);letter-spacing:.06em;text-underline-offset:.4rem;margin-top:1.5rem}.personnel{grid-column:span 5;background:#1b1930}.personnel h2{font-size:clamp(2.5rem,4vw,4rem)}.annotation{display:block;font:700 1.6rem var(--font-main);color:var(--rose);margin-top:1.5rem;transform:rotate(-3deg)}.prochain{grid-column:span 7;background:#282018}.prochain strong{color:var(--creme)}.prochain>p:not(.repere){max-width:33rem}.billet{display:inline-block;margin-top:2rem;padding:.8rem 1rem;background:var(--jaune);color:var(--ebene);box-shadow:4px 4px var(--rose);font:700 .85rem var(--font-label);text-transform:uppercase;letter-spacing:.07em;text-decoration:none}
@media(max-width:62rem){.intro{gap:2rem;grid-template-columns:1fr 1fr}.portrait{grid-column:span 5}.intention{grid-column:span 7}.plan{padding:1.5rem}.portrait{padding:0}.creations{gap:1rem}.repere{margin-bottom:1.5rem}}
@media(max-width:48rem){.intro{grid-template-columns:1fr;gap:1.5rem}.intro>p{max-width:35rem}.storyboard{grid-template-columns:1fr 1fr;gap:1rem}.portrait,.intention{grid-column:1/-1}.portrait{min-height:26rem;max-height:32rem}.portrait>img{object-position:center 30%;height:135%;top:-10%}.influences,.creations,.personnel,.prochain{grid-column:1/-1}.creations{grid-template-columns:1fr 1fr}.plan h2{font-size:2.4rem}.intention h2{font-size:2.8rem}.repere{font-size:.8rem}}
@media(max-width:25rem){.creations{grid-template-columns:1fr}.creations>a{width:60%;margin:1rem auto}.portrait{min-height:24rem}.plan h2{font-size:2rem}.plan{padding:1.25rem}.portrait{padding:0}.intention h2{font-size:2.4rem}}
</style>
