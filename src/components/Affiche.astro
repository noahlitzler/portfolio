---
import Visuel from './Visuel.astro';
const {projet: p, simple = false} = Astro.props;
---
<div class:list={['affiche-film', p.affiche.type, {simple}]} style={'--accent: '+p.accent}>
  {p.affiche.type === 'cimade' ? <div class="symbole"><img src="/figma/ad5c7.svg" alt={p.affiche.alt} loading="lazy" /></div> : p.affiche.type === 'prompt' ? <div class="prompt-art"><span>SAÉ 303 / EXPÉRIENCE INTERACTIVE</span><strong>DERRIÈRE<br/>LE PROMPT<span class="point">.</span></strong><p>L’ÉNERGIE INVISIBLE</p><div class="orbite" aria-hidden="true"></div><span class="chapters">01 REQUÊTE / 02 MODÈLES<br/>03 ÉNERGIE / 04 INFRASTRUCTURES</span></div> : <div class="image"><Visuel fichier={p.affiche.f} alt={p.affiche.alt} widths={[360,600,960]} sizes="(max-width: 60rem) 90vw, 30vw" /></div>}
  {!simple && <><p class="haut"><span>{p.presente}</span><span>{p.numero} / 03</span></p><div class="bas"><p class="titre">À l’affiche</p><p class="credits">{p.legende}</p><p class="seance">{p.seance}</p></div></>}
</div>
<style>
.affiche-film{position:relative;aspect-ratio:2/3;overflow:hidden;background:#100d1f;isolation:isolate}.image{position:absolute;inset:10.4% 0 0}.image :global(img){height:100%;width:100%;object-fit:cover}.haut{position:absolute;inset:0 0 auto;display:flex;justify-content:space-between;gap:1rem;margin:0;padding:7.6% 7.6% 10%;background:linear-gradient(#0d0a1acc,transparent);font:500 clamp(.7rem,.8vw,.9rem) var(--font-label);text-transform:uppercase;letter-spacing:.18em}.bas{position:absolute;inset:auto 0 0;padding:15% 7.6% 7%;background:linear-gradient(transparent,#0d0a1ae8 45%)}.titre{font:700 clamp(1.8rem,2.65vw,2.875rem) var(--font-label);text-transform:uppercase;letter-spacing:.08em;border-bottom:2px solid var(--creme);margin:0;padding-bottom:.4rem}.credits{font:400 .7rem/1.4 var(--font-label);text-transform:uppercase;margin:.8rem 0 1.5rem}.seance{font:700 .8rem var(--font-label);letter-spacing:.16em;text-transform:uppercase;margin:0}.cimade{background:linear-gradient(#d60000,#4d0000)}.cimade::before{content:'';position:absolute;inset:0;background:url('/figma/9a389.png') center/cover;opacity:.18}.symbole{position:absolute;inset:9% 6% 25%;display:grid;place-items:center;overflow:hidden}.symbole img{max-width:none;flex-shrink:0}.prompt-art{position:absolute;inset:0;padding:18% 7.6%;color:#8ce8f1;background:#070b19}.prompt-art>span{font:.6rem var(--font-timecode);letter-spacing:.12em}.prompt-art strong{position:relative;z-index:1;display:block;font:700 clamp(2rem,3.4vw,4.5rem)/.95 var(--font-label);letter-spacing:-.03em;margin:1.8rem 0 .7rem}.point{color:var(--vert-acide)}.prompt-art p{font:.8rem var(--font-timecode);letter-spacing:.12em}.orbite{position:absolute;width:80%;aspect-ratio:1;top:34%;left:22%;border:1px solid #8ce8f144;border-radius:50%;box-shadow:0 0 60px #8ce8f133,inset 0 0 60px #8ce8f122}.orbite::after{content:'';position:absolute;inset:15%;border:1px solid #8ce8f166;border-radius:50%}.chapters{display:block;position:relative;margin-top:25%;line-height:2!important}.simple .image{inset:0}.simple .prompt-art{padding-top:12%}
</style>