---
import Visuel from './Visuel.astro';
import { projets } from '../data/projets.js';
const {projet: p, simple = false} = Astro.props;
---
<div class:list={['affiche-film', p.affiche.type, {simple}]} style={'--accent: '+p.accent}>
  {p.affiche.type === 'cimade' ? <div class="symbole"><img src="/figma/80a27.svg" alt={p.affiche.alt} loading="lazy" /></div> : p.affiche.type === 'prompt' ? <div class="prompt-art"><span>SAÉ 303 / EXPÉRIENCE INTERACTIVE</span><strong>DERRIÈRE<br/>LE PROMPT<span class="point">.</span></strong><p>L’ÉNERGIE INVISIBLE</p><div class="orbite" aria-hidden="true"></div><span class="chapters">01 REQUÊTE / 02 MODÈLES<br/>03 ÉNERGIE / 04 INFRASTRUCTURES</span></div> : p.affiche.type === 'vitrine' ? <div class:list={['vitrine-art',p.slug]}><span class="vitrine-etiquette">{p.affiche.etiquette}</span><div class="vitrine-logo"><img src={p.affiche.logo} alt={p.titre} loading="lazy" /></div><p class="vitrine-sous-titre">{p.affiche.sousTitre}</p><div class="vitrine-image"><Visuel agrandissable={false} fichier={p.affiche.f} alt={p.affiche.alt} widths={[360,600,960]} sizes="(max-width: 40rem) 90vw, 30vw" /></div></div> : <div class="image"><Visuel agrandissable={false} fichier={p.affiche.f} alt={p.affiche.alt} widths={[360,600,960]} sizes="(max-width: 60rem) 90vw, 30vw" /></div>}
  {!simple && <><p class="haut"><span>{p.presente}</span><span>{p.numero} / {String(projets.length).padStart(2, "0")}</span></p><div class="bas"><p class="titre">À l’affiche</p><p class="credits">{p.legende}</p><p class="seance">{p.seance}</p></div></>}
</div>
<style>
.image :global(.visuel){height:100%}
.affiche-film{container-type:inline-size;position:relative;aspect-ratio:2/3;overflow:hidden;background:#100d1f;isolation:isolate}.image{position:absolute;inset:10.4% 0 0}.image :global(img){height:100%;width:100%;object-fit:cover}.haut{position:absolute;inset:0 0 auto;display:flex;justify-content:space-between;gap:1rem;margin:0;padding:7.6% 7.6% 10%;background:linear-gradient(#0d0a1acc,transparent);font:500 clamp(.7rem,.8vw,.9rem) var(--font-label);text-transform:uppercase;letter-spacing:.18em}.bas{position:absolute;inset:auto 0 0;padding:15% 7.6% 7%;background:linear-gradient(transparent,#0d0a1ae8 45%)}.titre{font:700 clamp(1.8rem,2.65vw,2.875rem) var(--font-label);text-transform:uppercase;letter-spacing:.08em;border-bottom:2px solid var(--creme);margin:0;padding-bottom:.4rem}.credits{font:400 .7rem/1.4 var(--font-label);text-transform:uppercase;margin:.8rem 0 1.5rem}.seance{font:700 .8rem var(--font-label);letter-spacing:.16em;text-transform:uppercase;margin:0}.cimade{background:linear-gradient(#d60000,#4d0000)}.cimade::before{content:'';position:absolute;inset:0;background:url('/figma/9a389.png') center/cover;opacity:.18}.symbole{position:absolute;left:8.7%;top:9.3%;right:0;bottom:25%;overflow:visible}.symbole img{position:absolute;left:0;top:0;max-width:none;transform-origin:top left;transform:scale(calc(100cqw / 472px))}.prompt-art{position:absolute;inset:0;padding:18% 7.6%;color:#8ce8f1;background:#070b19}.prompt-art>span{font:.6rem var(--font-timecode);letter-spacing:.12em}.prompt-art strong{position:relative;z-index:1;display:block;font:700 clamp(2rem,3.4vw,4.5rem)/.95 var(--font-label);letter-spacing:-.03em;margin:1.8rem 0 .7rem}.point{color:var(--vert-acide)}.prompt-art p{font:.8rem var(--font-timecode);letter-spacing:.12em}.orbite{position:absolute;width:80%;aspect-ratio:1;top:34%;left:22%;border:1px solid #8ce8f144;border-radius:50%;box-shadow:0 0 60px #8ce8f133,inset 0 0 60px #8ce8f122}.orbite::after{content:'';position:absolute;inset:15%;border:1px solid #8ce8f166;border-radius:50%}.chapters{display:block;position:relative;margin-top:25%;line-height:2!important}.simple .image{inset:0}.simple .prompt-art{padding-top:12%}

.vitrine-art{position:absolute;inset:0;padding:20% 7.6% 0;background:#080707;color:#f5dfbf}.vitrine-etiquette{display:block;font:.65rem var(--font-timecode);letter-spacing:.12em}.vitrine-logo{display:flex;align-items:center;margin:12% 0 4%;height:15%}.vitrine-logo img{display:block;max-width:100%;height:auto}.sull .vitrine-logo img{width:75%}.smooth .vitrine-logo img{width:90%}.vitrine-sous-titre{font:500 clamp(.9rem,1.35vw,1.4rem)/1.2 var(--font-label);max-width:15em;margin:0}.vitrine-image{margin:10% -9% 0}.vitrine-image :global(img){width:100%;height:auto;object-fit:contain}.smooth{background:#f6eedc;color:#141414}.smooth .vitrine-logo{background:#f5b700;box-shadow:4px 4px #141414;padding:7% 4%;height:18%;margin-top:10%}.smooth .vitrine-image{margin:6% -9% 0}.simple .vitrine-art{padding-top:9%}.vitrine .haut{background:linear-gradient(#0d0a1af2,transparent);color:var(--creme)}.vitrine .bas{color:var(--creme)}
</style>