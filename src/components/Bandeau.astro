---
const { texte = 'Séance en cours - Bienvenue dans la salle - Portfolio 2026' } = Astro.props;
---
<div class="bandeau" aria-hidden="true">
  <div class="perfo"></div>
  <div class="defile">{[0,1].map(()=><div class="groupe">{[0,1,2,3].map(()=><span class="phrase">{texte}</span>)}</div>)}</div>
  <div class="perfo"></div>
</div>
<style>
.bandeau{overflow:hidden;background:var(--ebene);border-block:1px solid #f2eee51a}
.perfo{height:1.2rem;background:radial-gradient(circle at 7px 50%,var(--rose) 3px,transparent 3.5px),radial-gradient(circle at 21px 50%,var(--creme) 3px,transparent 3.5px),radial-gradient(circle at 35px 50%,var(--bleu) 3px,transparent 3.5px),radial-gradient(circle at 49px 50%,var(--creme) 3px,transparent 3.5px);background-size:56px 100%}
.defile{display:flex;width:max-content;padding-block:.8rem;animation:defile 55s linear infinite;animation-duration:55s!important}
.groupe{display:flex;align-items:center;flex-shrink:0;gap:3rem;padding-right:3rem}
.phrase{font:700 clamp(1.25rem,2.4vw,2rem) var(--font-label);letter-spacing:.2em;text-transform:uppercase;white-space:nowrap}
@keyframes defile{to{transform:translateX(-50%)}}
</style>
