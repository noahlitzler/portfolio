---
const { texte = "Séance en cours - Bienvenue dans la salle - Portfolio 2026" } = Astro.props;
const repetitions = [1, 2, 3, 4];
---
<div class="bandeau" aria-hidden="true">
  <div class="perfo"></div>
  <div class="defile">
    {[0, 1].map(() => (
      <div class="groupe">
        {repetitions.map(() => (
          <>
            <span class="phrase">{texte}</span>
            <span class="point"></span>
          </>
        ))}
      </div>
    ))}
  </div>
  <div class="perfo"></div>
</div>

<style>
  .bandeau {
    overflow: hidden;
    background: var(--ebene);
  }
  .perfo {
    height: 1.5rem;
    background:
      radial-gradient(circle at 7px 50%, var(--rose) 3px, transparent 3.5px),
      radial-gradient(circle at 21px 50%, var(--creme) 3px, transparent 3.5px),
      radial-gradient(circle at 35px 50%, var(--bleu) 3px, transparent 3.5px),
      radial-gradient(circle at 49px 50%, var(--creme) 3px, transparent 3.5px);
    background-size: 56px 100%;
  }
  .defile {
    display: flex;
    width: max-content;
    padding-block: 0.75rem;
    animation: defile 80s linear infinite;
  }
  .groupe {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 2rem;
    padding-right: 2rem;
  }
  .phrase {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .point {
    flex-shrink: 0;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--rose);
  }
  @keyframes defile {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .defile { animation: none; }
  }
</style>