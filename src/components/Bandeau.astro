---
const { texte = 'Séance en cours - Bienvenue dans la salle - Portfolio 2026' } = Astro.props;
---
<div class="bandeau" data-bandeau>
  <div class="film" aria-hidden="true"><div class="perfo"></div><div class="defile">{[0,1].map(()=><div class="groupe">{[0,1,2,3].map(()=><><span class="phrase">{texte}</span><span class="point"></span></>)}</div>)}</div><div class="perfo retour"></div></div>
  <button type="button" class="commande" hidden aria-label="Mettre le bandeau défilant en pause">Pause <span aria-hidden="true">Ⅱ</span></button>
</div>
<script>
const preference = matchMedia('(prefers-reduced-motion: reduce)');
document.querySelectorAll<HTMLElement>('[data-bandeau]').forEach(bandeau => {
  const bouton = bandeau.querySelector<HTMLButtonElement>('button')!;
  let pause = preference.matches;
  function actualiser() {
    bandeau.dataset.mode = pause ? 'pause' : 'lecture';
    bouton.textContent = pause ? 'Lire la bande ▶' : 'Pause Ⅱ';
    bouton.setAttribute('aria-label', pause ? 'Démarrer ce bandeau défilant' : 'Mettre ce bandeau défilant en pause');
  }
  bouton.hidden = false;
  bouton.addEventListener('click', () => { pause = !pause; actualiser(); });
  preference.addEventListener('change', () => { pause = preference.matches; actualiser(); });
  actualiser();
});
</script>
<style>
.bandeau{position:relative;overflow:hidden;background:var(--ebene);border-block:1px solid #f2eee51a}.film{overflow:hidden}.perfo{height:1.2rem;background:radial-gradient(circle at 7px 50%,var(--rose) 3px,transparent 3.5px),radial-gradient(circle at 21px 50%,var(--creme) 3px,transparent 3.5px),radial-gradient(circle at 35px 50%,var(--bleu) 3px,transparent 3.5px),radial-gradient(circle at 49px 50%,var(--creme) 3px,transparent 3.5px);background-size:56px 100%;animation:perforations 14s linear infinite}.retour{animation-direction:reverse}.defile{display:flex;width:max-content;padding-block:.8rem;animation:defile 55s linear infinite}.groupe{display:flex;align-items:center;flex-shrink:0;gap:2rem;padding-right:2rem}.phrase{font:700 clamp(1.25rem,2.4vw,2rem) var(--font-label);letter-spacing:.2em;text-transform:uppercase;white-space:nowrap}.point{flex-shrink:0;width:.65rem;height:.65rem;border-radius:50%;background:var(--rose);box-shadow:0 0 12px #ff2d8d55}.commande:not([hidden]){display:flex;align-items:center;gap:.5rem;position:absolute;right:0;top:50%;transform:translateY(-50%);min-height:44px;min-width:90px;padding:.65rem 1rem;border:1px solid #f2eee544;background:#0e0b0af2;color:var(--creme);font:500 .7rem var(--font-label);letter-spacing:.06em;text-transform:uppercase;cursor:pointer;box-shadow:-1rem 0 1rem #0e0b0a}.commande:hover{background:var(--creme);color:var(--ebene)}[data-mode=pause] .defile,[data-mode=pause] .perfo{animation-play-state:paused}
@keyframes defile{to{transform:translateX(-50%)}}@keyframes perforations{to{background-position:-112px 0}}
@media(prefers-reduced-motion:reduce){.bandeau:not([data-mode=lecture]) .defile,.bandeau:not([data-mode=lecture]) .perfo{animation:none}.bandeau[data-mode=lecture] .defile{animation-duration:55s!important}.bandeau[data-mode=lecture] .perfo{animation-duration:14s!important}}
</style>
