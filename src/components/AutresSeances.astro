---
import {autresProjets} from '../data/autres-projets.js';
---
<section class="autres-seances" aria-labelledby="autres-seances-titre">
 <p class="etiquette">La programmation continue</p><h2 id="autres-seances-titre">Autres séances</h2>
 <ul>{autresProjets.map(p=><li><article class="seance-complementaire"><div class="logo-seance"><img src={p.logo} alt={p.logoAlt} loading="lazy" /></div><div class="presentation-seance"><p class="numero">Séance {p.numero} · {p.categorie}</p><h3>{p.titre}</h3><p>{p.description}</p></div><a class="explorer" href={p.url} target="_blank" rel="noopener noreferrer" aria-label={'Explorer '+p.titre+' (nouvel onglet)'}>Explorer {p.titre} <span aria-hidden="true">↗</span></a></article></li>)}</ul>
</section>
<style>
.autres-seances{padding:clamp(2rem,5vw,4rem) var(--gouttiere);border-top:1px solid #f2eee52b}.etiquette{display:inline-block;margin:0;padding:.3rem .75rem;background:var(--creme);color:var(--ebene);border-left:4px solid var(--vert-acide);font:700 .875rem var(--font-label);letter-spacing:.12em;text-transform:uppercase}h2{font:700 clamp(2rem,5vw,4rem)/1.1 var(--font-titre);letter-spacing:-.035em;margin:1.5rem 0 2rem}ul{list-style:none;padding:0;margin:0}.seance-complementaire{display:grid;grid-template-columns:10rem minmax(0,1fr) auto;gap:2rem;align-items:center;padding:2rem;border:1px solid #f2eee533;background:var(--brun-salle)}.logo-seance{display:grid;place-items:center;min-height:8rem;padding:1rem;background:#050504;border-bottom:3px solid var(--vert-acide)}.logo-seance img{width:100%;height:auto;max-height:6rem;object-fit:contain}.presentation-seance{min-width:0}.numero{font:.8rem var(--font-label);letter-spacing:.08em;text-transform:uppercase;color:#f2eee599;margin:0 0 .6rem}h3{font:700 2.3rem/1 var(--font-titre);letter-spacing:-.035em;margin:0 0 .8rem}.presentation-seance>p:last-child{margin:0;max-width:40rem;line-height:1.6;color:#f2eee5cc}.explorer{display:inline-flex;gap:1rem;align-items:center;font:700 .9rem var(--font-label);letter-spacing:.1em;text-transform:uppercase;text-decoration:none;border-bottom:2px solid var(--creme);padding:.5rem 0;white-space:nowrap}.explorer:hover{color:var(--vert-acide);border-color:var(--vert-acide)}@media(max-width:48rem){.seance-complementaire{grid-template-columns:minmax(0,1fr);gap:1.5rem;padding:1.25rem}.logo-seance{width:10rem;min-height:6rem}.explorer{justify-self:start}.numero{font-size:.75rem}}
</style>