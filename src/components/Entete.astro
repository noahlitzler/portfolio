---
const { timecode, progression } = Astro.props;
const chemin = Astro.url.pathname.replace(/\/$/, "");
const chapitres = [
  { n: "01", href: "/projets", texte: "Projets" },
  { n: "02", href: "/a-propos", texte: "À propos" },
  { n: "03", href: "/contact", texte: "Contact" },
];
const actif = (href) => chemin === href || chemin.startsWith(href + "/");
---
<header class="entete" style={`--p:${progression}%`}>
  <a class="marque" href="/">Noah Litzler</a>

  <nav class="principale" aria-label="Navigation principale">
    <ul>
      {chapitres.map((c) => (
        <li>
          <a href={c.href} aria-current={actif(c.href) ? "page" : undefined}>
            <span class="num">CH.{c.n}</span>
            <span class="nom">{c.texte}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="droite">
    <p class="timecode" aria-hidden="true">
      <svg width="10" height="12" viewBox="0 0 10 12" aria-hidden="true"><path d="M0 0l10 6-10 6z" fill="currentColor" /></svg>
      {timecode}
    </p>
    <button class="ouvrir-chapitres" type="button" aria-haspopup="dialog" aria-controls="menu-chapitres">☰ <span>Chapitres</span></button>
  </div>

  <div class="progression" aria-hidden="true"></div>
</header>
<dialog id="menu-chapitres" aria-labelledby="titre-chapitres">
  <a class="menu-marque" href="/">Noah Litzler</a>
  <div class="menu-tete"><div><p>Menu du film</p><h2 id="titre-chapitres">Sélection des chapitres</h2></div><p>Noah Litzler - 2026 - 4 chapitres</p></div>
  <nav aria-label="Sélection des chapitres"><ol class="menu-scenes">{[{n:'01',href:'/',texte:'Accueil',tc:'00:00:00:00'},...chapitres.map((c,i)=>({...c,n:String(i+2).padStart(2,'0'),tc:['00:03:12:08','00:07:40:16','00:10:05:02'][i]}))].map(c=><li><a href={c.href} aria-current={chemin===c.href || (c.href==='/' && chemin==='')?'page':undefined}><span class={'vignette scene-'+c.n} aria-hidden="true"><span>{c.n}</span></span><span class="menu-meta"><span>CH.{c.n}</span><span>{c.tc}</span></span><strong>{c.texte}</strong></a></li>)}</ol></nav>
  <aside class="menu-contact"><p>Écrire directement</p><a href="mailto:noah.litzler@gmail.com">noah.litzler@gmail.com</a><div><a href="https://www.linkedin.com/in/noah-litzler-a36529385/">LinkedIn</a><a href="https://www.instagram.com/noahlitzler/">Instagram</a></div></aside>
  <div class="menu-bas"><button class="fermer-chapitres" type="button" autofocus>◀ Retour au film</button><p>choisis ta scène !</p></div>
</dialog>
<script>
const menu = document.querySelector<HTMLDialogElement>('#menu-chapitres');
const ouvrir = document.querySelector<HTMLButtonElement>('.ouvrir-chapitres');
ouvrir?.addEventListener('click', () => menu?.showModal());
document.querySelector('.fermer-chapitres')?.addEventListener('click', () => menu?.close());
menu?.addEventListener('click', (event) => {if(event.target === menu){const r=menu.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)menu.close();}});
menu?.addEventListener('close', () => ouvrir?.focus());
</script>

<style>
.ouvrir-chapitres,.fermer-chapitres{display:inline-flex;align-items:center;gap:.6rem;border:1.5px solid var(--creme);padding:.65rem 1rem;background:transparent;color:var(--creme);font:500 .875rem var(--font-label);letter-spacing:.1em;text-transform:uppercase;cursor:pointer}.ouvrir-chapitres:hover,.fermer-chapitres:hover{background:var(--creme);color:var(--ebene)}dialog{width:min(calc(100% - 2rem),81.125rem);max-height:calc(100dvh - 2rem);padding:clamp(1.5rem,3.3vw,3.56rem);border:1px solid #f2eee540;background:var(--brun-salle);color:var(--creme)}dialog::backdrop{background:#0e0b0ae6;backdrop-filter:blur(5px)}html:has(dialog[open]){overflow:hidden}.menu-tete{display:flex;align-items:center;justify-content:space-between;gap:2rem}.menu-tete p{font:.875rem var(--font-label);letter-spacing:.12em;text-transform:uppercase;margin:0 0 .5rem}.menu-tete>p{color:#f2eee580}.menu-tete h2{font:700 clamp(1.6rem,3vw,3rem)/1.1 var(--font-titre);text-transform:uppercase;margin:0}.menu-scenes{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:2rem;list-style:none;padding:0;margin:2.5rem 0}.menu-scenes a{text-decoration:none;display:block}.vignette{display:grid;place-items:center;aspect-ratio:16/9;background:var(--ebene);border:1px solid #f2eee533;transition:transform .2s}.vignette>span{font:700 clamp(2.5rem,5vw,5rem) var(--font-titre);opacity:.8}.scene-01{background:url('/figma/283dd.png') center/cover}.scene-01>span{opacity:0}.scene-02{background:url('/figma/54817.png') center/cover}.scene-02>span{opacity:0}.scene-03{background:url('/figma/5fe81.png') center/cover}.scene-04{background:url('/figma/88d3c.png') center/cover}.scene-03>span,.scene-04>span{opacity:0}.menu-scenes a:hover .vignette,.menu-scenes a:focus-visible .vignette{transform:translateY(-4px);border-color:var(--rose)}.menu-meta{display:flex;justify-content:space-between;gap:.3rem;font:.75rem var(--font-timecode);margin:1rem 0;color:#f2eee5aa}.menu-scenes strong{font:700 1.75rem var(--font-titre);text-transform:uppercase}.menu-scenes a[aria-current=page] strong{color:var(--rose)}.menu-bas{display:flex;align-items:center;justify-content:space-between;gap:1rem}.menu-bas p{font:700 2rem var(--font-main);color:var(--rose);transform:rotate(-3deg);margin:0}@media(max-width:45rem){.menu-scenes{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem 1rem}.menu-tete>p{display:none}.menu-meta{font-size:.65rem}.menu-scenes strong{font-size:1.4rem}.menu-bas p{font-size:1.5rem}}

  .entete {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem clamp(1rem, 4vw, 4rem);
    border-bottom: 1px solid color-mix(in srgb, var(--creme) 15%, transparent);
  }
  .marque {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .marque::before {
    content: "";
    width: 0.75rem;
    height: 0.75rem;
    background: var(--rose);
  }
  .principale ul {
    display: flex;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .principale a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid transparent;
    font-family: var(--font-label);
    font-size: 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .num {
    font-size: var(--taille-label);
    color: color-mix(in srgb, var(--creme) 60%, transparent);
  }
  .principale a:hover .nom { color: var(--jaune); }
  .principale a[aria-current="page"] {
    color: var(--rose);
    border-bottom-color: var(--rose);
  }
  .principale a[aria-current="page"] .num { color: var(--rose); }
  .droite {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .timecode {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-timecode);
    font-weight: 700;
    font-size: var(--taille-label);
    letter-spacing: 0.12em;
  }
  .timecode svg { color: var(--rose); }
  .chapitres { position: relative; }
  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--creme);
    font-family: var(--font-label);
    font-weight: 500;
    font-size: var(--taille-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  summary::marker { content: ""; }
  .chapitres[open] summary {
    background: var(--creme);
    color: var(--ebene);
  }
  .chapitres ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 50;
    min-width: 14rem;
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    background: var(--brun-salle);
    border: 1px solid color-mix(in srgb, var(--creme) 25%, transparent);
  }
  .chapitres li a {
    display: block;
    padding: 0.6rem 0.75rem;
    font-family: var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .chapitres li a:hover {
    background: var(--creme);
    color: var(--ebene);
  }
  .progression {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: var(--p);
    height: 2px;
    background: var(--rose);
  }
  .progression::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -4px;
    width: 2px;
    height: 6px;
    background: var(--rose);
  }
  @media (max-width: 56rem) {
    .entete { grid-template-columns: 1fr auto; }
    .principale, .timecode { display: none; }
  }
.menu-marque,.menu-contact{display:none}
@media(max-width:45rem){dialog{inset:0;margin:0;width:100%;height:100dvh;max-width:none;max-height:none;border:0;padding:1.25rem;background:var(--ebene)}.menu-marque{position:absolute;top:1.25rem;left:1.25rem;display:flex;align-items:center;gap:.65rem;font:700 1.1rem var(--font-label);text-transform:uppercase;letter-spacing:.08em;text-decoration:none}.menu-marque::before{content:'';width:.65rem;height:.65rem;background:var(--rose)}.menu-tete{padding-top:5rem}.menu-tete>div>p{color:var(--rose)}.menu-tete h2{font:700 clamp(1.5rem,6vw,2rem) var(--font-label)}.menu-scenes{display:block;margin:1.5rem 0}.menu-scenes li{border-bottom:1px solid #f2eee533;padding:1rem 0}.menu-scenes a{display:grid;grid-template-columns:minmax(5rem,32%) 1fr;grid-template-rows:auto auto;align-items:center;gap:.25rem 1rem}.vignette{grid-row:1/3}.menu-meta{grid-column:2;grid-row:1;justify-content:flex-start;gap:.65rem;margin:0;font-size:.7rem}.menu-meta>span:first-child{color:var(--rose)}.menu-scenes strong{grid-column:2;grid-row:2;font:700 clamp(1.6rem,7vw,2.5rem) var(--font-label)}.menu-bas{justify-content:flex-end}.fermer-chapitres{position:absolute;right:1.25rem;top:.6rem;padding:.75rem;font-size:.8rem}.menu-contact{display:block;margin-top:4rem;padding-bottom:1rem;font-family:var(--font-label)}.menu-contact p{color:var(--rose);text-transform:uppercase;font-size:.875rem;letter-spacing:.12em}.menu-contact a{text-decoration:none}.menu-contact>div{display:flex;gap:1.5rem;margin-top:.8rem;text-transform:uppercase;letter-spacing:.1em}.menu-bas{margin-top:1rem}.menu-contact{position:relative}.menu-bas p{font-size:1.8rem}}
@media(max-width:24rem){.marque{font-size:1rem;gap:.5rem}.ouvrir-chapitres{font-size:.75rem;padding:.65rem .75rem}.entete{gap:.5rem}}
</style>