---
import {Image,getImage} from 'astro:assets';import Affiche from './Affiche.astro';
const {projet:p}=Astro.props;const illustrations=import.meta.glob('/src/assets/projets/*.{png,jpg,jpeg,webp}',{eager:true,import:'default'});const image=illustrations['/src/assets/projets/'+p.affiche.f];const fond=image?await getImage({src:image,width:1200,format:'webp',quality:80}):null;
const contexte={'vivez-l-essentiel':'Pays de Montbéliard Tourisme','la-cimade':'Identité visuelle · Projet pédagogique','derriere-le-prompt':'SAÉ 303 · Avec Clément Bertrand'}[p.slug];
---
<section class:list={['project-opening',p.slug]} style={fond?'--art:url('+fond.src+')':undefined} aria-labelledby="titre-projet">
 <div class="monument-detail" aria-hidden="true"></div><div class="project-id"><a href="/projets">← Programmation</a><span>Séance {p.numero} / {p.categorie}</span></div>
 <div class="project-title"><p>{contexte}</p><h1 id="titre-projet">{p.slug==='vivez-l-essentiel'?<>Vivez<br/>l’essentiel<span>.</span></>:p.slug==='la-cimade'?<>La<br/>Cimade<span>.</span></>:<>Derrière<br/>le prompt<span>.</span></>}</h1></div>
 <div class="poster-shadow" style={'view-transition-name: affiche-'+p.slug}>
  {image?<Image src={image} alt={p.affiche.alt} widths={[480,800,1000]} sizes="(max-width:48rem) 45vw,30vw" format="webp" />:p.slug==='la-cimade'?<div class="poster-logo"><img src="/figma/fb8ae.svg" alt="Logo proposé pour La Cimade" width="492" height="202" /></div>:<Affiche projet={p} simple />}
 </div>
 <div class="project-bottom"><p>{p.resume}</p><a class="making-link" href="#t-pitch">Entrer dans le making-of <span aria-hidden="true">↙</span></a></div>
</section>
<aside class="fiche-generique" aria-label="Crédits du projet"><dl>{p.credits.map(([role,valeur])=><div><dt>{role}</dt><dd>{valeur}</dd></div>)}</dl>{p.url&&<a class="lien-editorial" href={p.url} target="_blank" rel="noopener noreferrer">Explorer le site ↗</a>}</aside>