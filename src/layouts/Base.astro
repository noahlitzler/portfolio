---
import "@fontsource/oswald/latin-400.css";
import "@fontsource/oswald/latin-500.css";
import "@fontsource/oswald/latin-700.css";
import "@fontsource/caveat/latin-700.css";
import "@fontsource/courier-prime/latin-700.css";
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/global.css";
import Entete from "../components/Entete.astro";
import PiedDePage from "../components/PiedDePage.astro";

const { titre, description, timecode = "00:00:00:00", progression = 0, precedent, suivant } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titre} - Noah Litzler</title>
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <Entete timecode={timecode} progression={progression} />
    <main id="contenu">
      <slot />
    </main>
    <PiedDePage precedent={precedent} suivant={suivant} />
  </body>
</html>